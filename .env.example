NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
NEXT_PUBLIC_APP_URL=https://app.okomosfinanzas.com
NEXT_PUBLIC_SITE_URL=https://app.okomosfinanzas.com

# WebAuthn / Passkeys (opcional — se infiere del SITE_URL si no se define)
WEBAUTHN_RP_ID=app.okomosfinanzas.com
WEBAUTHN_ORIGIN=https://app.okomosfinanzas.com

# Stripe — en producción usa sk_live_ / pk_live_ y STRIPE_PRICE_ID
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_TEST_PRICE_ID=price_...
STRIPE_PRICE_ID=price_...
NEXT_PUBLIC_COMMUNITY_URL=https://nas.com/tupulso/join-membership/6a2c795656d1b91a1c12d25e

# OTP de recuperación (si falta, se usa SUPABASE_SERVICE_ROLE_KEY)
PASSWORD_RESET_PEPPER=cambia-esto

# Admin — OTP de recuperación de contraseña (solo servidor)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Resend — SMTP de Supabase Auth (confirmación, reset password)
# En Resend SMTP la contraseña es la API key (usuario: resend, host: smtp.resend.com, puerto: 587)
RESEND_API_KEY=re_...

# Solo para scripts/sync-supabase-smtp.mjs (Personal Access Token de supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_PROJECT_REF=xnyndxlqjpiwcsdxmwwg
